{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ChatCompletionSystemMessageParam",
  "title": "ChatCompletionSystemMessageParam",
  "properties": {
    "content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/components/schemas/ChatCompletionContentPartTextParam"
          },
          "type": "array"
        }
      ],
      "title": "Content"
    },
    "role": {
      "type": "string",
      "const": "system",
      "title": "Role"
    },
    "name": {
      "type": "string",
      "title": "Name"
    }
  },
  "type": "object",
  "required": [
    "content",
    "role"
  ],
  "description": "Developer-provided instructions that the model should follow, regardless of\nmessages sent by the user. With o1 models and newer, use `developer` messages\nfor this purpose instead."
}
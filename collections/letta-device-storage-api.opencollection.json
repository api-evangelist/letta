{
  "opencollection": "1.0.0",
  "info": {
    "name": "Letta Admin Device Storage API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Device Storage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Device Storage Key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letta.com/v1/device-storage-key",
            "params": [
              {
                "name": "deviceId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns an HMAC-derived AES-256-GCM key scoped to the authenticated user and device. Used to encrypt/decrypt local IndexedDB caches on the client."
        }
      ]
    }
  ],
  "bundled": true
}